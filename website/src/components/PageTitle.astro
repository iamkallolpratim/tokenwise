---
// The landing page renders its own <h1> in the hero, so Starlight's page title is skipped there
// (one h1 per page). Every other page uses the default title.
import Default from "@astrojs/starlight/components/PageTitle.astro";

const isLanding = Astro.url.pathname === import.meta.env.BASE_URL;
---

{!isLanding && <Default />}
