{
  "name": "@klawde91/tokenwise",
  "version": "0.1.0",
  "description": "Find and reduce unnecessary LLM token usage in prompts, agent instructions, skills, and tool schemas \u2014 without degrading behavior.",
  "license": "MIT",
  "homepage": "https://iamkallolpratim.github.io/tokenwise/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamkallolpratim/tokenwise.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/iamkallolpratim/tokenwise/issues"
  },
  "type": "module",
  "bin": {
    "tokenwise": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "keywords": [
    "llm",
    "tokens",
    "prompt",
    "claude-code",
    "codex",
    "agents",
    "cli"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-skills.mjs",
    "prepack": "node ../../scripts/copy-package-files.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "diff": "9.0.0",
    "fast-glob": "3.3.3",
    "gpt-tokenizer": "4.1.0",
    "ignore": "7.0.14",
    "picocolors": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tokenwise/core": "workspace:^",
    "@tokenwise/integrations": "workspace:^",
    "@tokenwise/shared": "workspace:^",
    "@tokenwise/tokenizers": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "TokenWise contributors"
}
